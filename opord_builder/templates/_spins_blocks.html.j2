{% macro blocks(items, path='content', depth=1) -%}
{% for block in items %}
{{ render_block(block, path ~ '-' ~ loop.index0, depth) }}
{% endfor %}
{%- endmacro %}

{% macro render_block(block, here, depth) -%}
{% set node_id = anchor(block, here) %}
{% set label = labels[here] %}
{% if block.kind == 'section' %}
<section id="{{ node_id|e }}" class="publication-section role-{{ block.role }}" data-depth="{{ depth }}">
  {% set level = [depth + 1, 6]|min %}
  <h{{ level }}><span class="label">{{ label|e }}</span> {{ block.title|e }}</h{{ level }}>
  {{ blocks(block.blocks, here, depth + 1) }}
</section>
{% elif block.kind == 'paragraph' %}
<div id="{{ node_id|e }}" class="paragraph" data-depth="{{ depth }}">
  <p><span class="label">{{ label|e }}</span> {% if block.lead %}<span class="lead">{{ rich_html(block.lead) }}</span> {% endif %}{{ rich_html(block.text) }}</p>
  {% if block.blocks %}<div class="nested">{{ blocks(block.blocks, here, depth + 1) }}</div>{% endif %}
</div>
{% elif block.kind == 'list' %}
{% set tag = 'ul' if block.style == 'bullet' else 'ol' %}
<div id="{{ node_id|e }}"><p class="label">{{ label|e }}</p>
<{{ tag }}{% if tag == 'ol' %} type="{{ list_types[block.style] }}" start="{{ block.start }}"{% endif %}>
{% for item in block.items %}
<li>{{ rich_html(item.text) }}
{% if item.blocks %}{{ blocks(item.blocks, here ~ '-item-' ~ loop.index0, depth + 1) }}{% endif %}</li>
{% endfor %}</{{ tag }}></div>
{% elif block.kind == 'table' %}
<div id="{{ node_id|e }}" class="table-wrap"><table>
<caption>{{ label|e }}. {{ block.caption|e }}</caption>
<thead><tr>{% for column in block.columns %}<th scope="col" class="align-{{ column.align }}">{{ column.heading|e }}</th>{% endfor %}</tr></thead>
<tbody>{% for row in block.rows %}<tr>{% for column in block.columns %}<td class="align-{{ column.align }}">{{ rich_html(row[column.key]) }}</td>{% endfor %}</tr>{% endfor %}</tbody>
</table></div>
{% elif block.kind == 'figure' %}
<figure id="{{ node_id|e }}"><img src="{{ figures[here]|e }}" alt="{{ block.alt|e }}" style="width:{{ block.width_percent }}%"><figcaption>{{ label|e }}. {{ block.caption|e }}</figcaption></figure>
{% elif block.kind == 'note' %}
<div id="{{ node_id|e }}" class="publication-note"><p><strong>{{ label|e }}.{% if block.heading != 'NOTE' %} {{ block.heading|e }}.{% endif %}</strong> {{ rich_html(block.text) }}</p></div>
{% elif block.kind == 'reference' %}
{% set reference = citations[block.reference] %}
<p id="{{ node_id|e }}"><a href="#citation-{{ reference.id|e }}">{{ label|e }}: {{ reference.title|e }}</a></p>
{% endif %}
{%- endmacro %}
