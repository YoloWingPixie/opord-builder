<!DOCTYPE html>
{% import '_spins_blocks.html.j2' as publication with context %}
{% from '_seal.html.j2' import seal %}
<html lang="en">
<head><meta charset="UTF-8"><meta name="viewport" content="width=device-width,initial-scale=1">
<title>{{ document.meta.title }}</title>
<style>{{ stylesheet|safe }}
@page { size: {{ document.presentation.page_size }}; }
{% if theme %}
{{ theme_css|safe }}
@page { @bottom-center { content: element(publication-header); } }
{% endif %}
</style></head>
<body class="spins-document font-{{ document.presentation.font }} case-{{ document.presentation.text_case }}{% if theme %} theme-{{ theme }}{% endif %}">
<div class="running-header">{% if document.meta.classification %}{{ document.meta.classification.value }}{% endif %}{% if document.meta.handling %} · {{ document.meta.handling }}{% endif %}</div>
<div class="running-footer">{{ document.meta.id }} · Revision {{ document.meta.revision }}</div>
<main>
<header class="publication-header">
{% if theme %}
{{ seal(document.meta.issuing_unit or document.meta.id) }}
{% endif %}
  <h1>{{ document.meta.title }}</h1>
  {% if document.meta.operation %}<p>{{ document.meta.operation }}</p>{% endif %}
  <p>{{ document.meta.id }} · Revision {{ document.meta.revision }}{% if document.meta.issued_at %} · Issued {{ document.meta.issued_at.isoformat() }}{% endif %}</p>
  {% if document.meta.issuing_unit %}<p>{{ document.meta.issuing_unit }}</p>{% endif %}
  {% if document.meta.author %}<p>{{ document.meta.author }}</p>{% endif %}
  {% if document.period %}<p>Effective {{ document.period.start.isoformat() }} to {{ document.period.end.isoformat() }}</p>{% endif %}
</header>
{% if document.presentation.contents and contents %}
<nav class="publication-contents" aria-label="Contents"><h2>Contents</h2><ol>
{% for path, section in contents %}<li><a href="#{{ anchor(section, path) }}">{{ labels[path] }} {{ section.title }}</a></li>{% endfor %}
</ol></nav>
{% endif %}
{{ publication.blocks(document.content) }}
{% if document.meta.references %}<section class="references"><h2>References</h2><ol>
{% for reference in document.meta.references %}
<li id="citation-{{ reference.id }}">{% if reference.author %}{{ reference.author }}. {% endif %}{% if reference.url %}<a href="{{ reference.url }}">{{ reference.title }}</a>{% else %}{{ reference.title }}{% endif %}{% if reference.date %}, {{ reference.date }}{% endif %}{% if reference.locator %}, {{ reference.locator }}{% endif %}.</li>
{% endfor %}</ol></section>{% endif %}
{% if document.meta.distribution %}<section><h2>Distribution</h2><ul>{% for recipient in document.meta.distribution %}<li>{{ recipient }}</li>{% endfor %}</ul></section>{% endif %}
</main></body></html>
