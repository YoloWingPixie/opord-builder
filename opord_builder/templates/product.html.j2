<!DOCTYPE html>
{%- from '_page.html.j2' import page_css -%}
{%- set banner = eff.classification ~ ('//' ~ eff.caveat if eff.caveat else '') -%}
<html lang="en">
<head>
  <meta charset="UTF-8">
  <title>{{ product_title }} — OPORD {{ eff.op_number }} {{ eff.op_name }}</title>
  <style>{{ page_css(banner, product_title|upper ~ ' / OPORD ' ~ eff.op_number, none, watermark_url) }}</style>
</head>
<body class="classification-{{ eff.classification|lower|replace(' ', '-') }}{% if theme %} theme-{{ theme }}{% endif %}">

<section class="product-cover">
  <div class="product-eyebrow">
    <span class="product-eyebrow-tag">PRODUCT</span>
    <span class="product-eyebrow-sub">{{ product_subtitle }}</span>
  </div>
  <h1 class="product-title">{{ product_title }}</h1>
  <div class="product-meta">
    <div class="product-meta-row"><span class="product-meta-k">OPORD</span><span class="product-meta-v">{{ eff.op_number }} · {{ eff.op_name }}</span></div>
    <div class="product-meta-row"><span class="product-meta-k">Issuing HQ</span><span class="product-meta-v">{{ eff.hq }}</span></div>
    <div class="product-meta-row"><span class="product-meta-k">DTG Signed</span><span class="product-meta-v">{{ eff.dtg }}</span></div>
    <div class="product-meta-row"><span class="product-meta-k">Product Generated</span><span class="product-meta-v">{{ generated_at }}</span></div>
  </div>
</section>

<section class="product-body">
  {% if product_body_html %}{{ product_body_html | safe }}{% else %}<p class="product-empty">No entries recorded for this product.</p>{% endif %}
</section>

</body>
</html>
